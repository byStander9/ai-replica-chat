{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "rootDir": "src/client",
    "outDir": "dist/client",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [],
    "skipLibCheck": true
  },
  "include": [
    "src/client/**/*.ts"
  ]
}