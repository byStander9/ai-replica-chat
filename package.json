{
  "name": "ai-replica-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Synthetic localhost-only AI replica chat mock",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "eslint src tests scripts eslint.config.js",
    "test": "npm run build && node --test dist/tests/service.test.js dist/tests/http.test.js dist/tests/openai.test.js dist/tests/config.test.js dist/tests/codex.test.js",
    "start": "node dist/src/server.js --demo",
    "dev": "npm run build && npm start",
    "start:ai": "node dist/src/server.js --demo --synthetic-ai",
    "dev:ai": "npm run build && npm run start:ai",
    "test:live": "npm run build && node dist/scripts/live-check.js --confirm-synthetic-api",
    "start:cli": "node dist/src/server.js --demo --synthetic-cli",
    "dev:cli": "npm run build && npm run start:cli",
    "test:cli-config": "npm run build && node dist/scripts/cli-config-check.js",
    "test:cli-live": "npm run build && node dist/scripts/cli-live-check.js --confirm-synthetic-cli"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "eslint": "10.13.0",
    "typescript-eslint": "8.72.1"
  }
}
